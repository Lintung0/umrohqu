NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SERVICE_ROLE=

XENDIT_SECRET_KEY=

# Midtrans (payment gateway)
# Server Key: dari dashboard Midtrans (https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
# Client Key publik (dimasukkan jika memakai Snap JS, bukan mandatory untuk redirect)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set "true" untuk produksi, biarkan kosong untuk sandbox
MIDTRANS_IS_PRODUCTION=

# Google Gemini AI (gratis — daftar di https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# WhatsApp OTP (opsional — dev mode otomatis log ke console)
WHATSAPP_PROVIDER=console
# Untuk Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Untuk Meta WhatsApp Business API:
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_OTP_TEMPLATE=otp